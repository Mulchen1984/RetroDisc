# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated audits and temporary files
.audit_tmp/
*.log
*.tmp
*.temp
*.bak
*~

# Build and release outputs (keep on disk, do not version)
build/
dist/
Output/
*.pkg
*.iso
*.dmg

# Downloaded/generated third-party runtimes and ML models
vendor/

# Portable runtime data written next to the app (settings.json, library.db, ...)
RetroDisc_Data/

# Machine-local agent settings (project settings stay versioned)
.claude/settings.local.json

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Code-signing material. Never commit certificates, keys or passwords --
# see SIGNING.md. Configuration reaches the build through environment
# variables only (RETRODISC_SIGN_*).
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
signing/
.env
.env.*
