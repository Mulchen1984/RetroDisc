# Machine-local agent settings (project settings stay versioned)
.claude/settings.local.json

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Release staging artifacts; reviewable reports/instructions remain versioned
